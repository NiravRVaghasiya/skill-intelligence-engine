# The core retrieval + graph engine runs with NO key and needs none of these.
# Comments sit on their own lines: dotenv loaders would read a trailing comment as the value.
# Unset or empty means "use the default". Invalid values fail with an error naming the variable
# (the API then answers 503 and /ready says why). Booleans accept 1/0, true/false, yes/no, on/off
# (any case).

# --- Corpus and indexes (sie.engine.Engine.from_env: API, demo) ---
# corpus root: a directory of SKILL.md files, optionally with corpus.toml;
# default <repo>/data/skills (resolved from the source checkout, independent of the cwd)
# SIE_SKILLS_DIR=
# explicit corpus manifest; default <SIE_SKILLS_DIR>/corpus.toml if present
# SIE_CORPUS_MANIFEST=
# ChromaDB directory of the dense index; default <repo>/data/chroma
# SIE_PERSIST_DIR=
# edge overlays applied to the skill graph (JSON, see docs/proposed_requires.edges.json);
# several paths separated by the OS path separator (";" on Windows, ":" elsewhere)
# SIE_EDGE_OVERLAYS=

# --- Retrieval ---
# hybrid (dense + BM25, default) | dense | sparse (BM25 only: no index, no model)
SIE_MODE=hybrid
# onnx (chromadb's bundled all-MiniLM-L6-v2, default) | sentence-transformers
SIE_EMBEDDER=onnx
# 0 serves RRF order without loading a cross-encoder; default 1
SIE_RERANK=1
# cross-encoder: HF id or local dir; default <repo>/data/models/ms-marco-MiniLM-L-6-v2 if present,
# else cross-encoder/ms-marco-MiniLM-L-6-v2 from the Hugging Face hub
# SIE_RERANKER=
# 1 = a cross-encoder that can't load is an error (not ready) instead of a fallback to RRF order
SIE_STRICT_RERANK=0
# skills returned when a request does not say (default 5)
# SIE_TOP_K=
# candidate chunks per retriever (default 20)
# SIE_POOL=
# top fused skills whose chunks are cross-encoded (default: the pool)
# SIE_RERANK_K=

# --- Service (sie.api) ---
# 0 skips warm-up at startup; the first /ready call then starts the engine (default 1).
# An invalid value is logged, warm-up runs (the default) and /ready reports it (503).
SIE_EAGER_INIT=1
# log level of the "sie" loggers (routing events are JSON lines at INFO); default WARNING
SIE_LOG_LEVEL=WARNING
# 1 includes raw query text in routing events (off by default: only a sha256 prefix + length)
SIE_LOG_QUERIES=0

# --- Tests ---
# 1 runs tests/integration (real models + a built index; models must already be cached)
# SIE_INTEGRATION=

# --- Optional LLM (LLM-as-judge eval and learning-path narration only) ---
# one of: noop | openai | ollama
LLM_PROVIDER=noop
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-4o-mini
