# The core retrieval + graph engine runs with NO key.
# Set these only to enable LLM-as-judge eval and learning-path narration.
# (Comments sit on their own lines: dotenv loaders would read a trailing comment as the value.)

# one of: noop | openai | ollama
LLM_PROVIDER=noop
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-4o-mini

# --- Retrieval (all optional) ---
# onnx (chromadb's bundled all-MiniLM-L6-v2) | sentence-transformers
SIE_EMBEDDER=onnx
# cross-encoder: HF id or local dir; unset/empty -> data/models/ms-marco-MiniLM-L-6-v2 if present
# SIE_RERANKER=
# API only: 0 serves RRF order without loading a reranker
SIE_RERANK=1
# API corpus / index directories; unset -> <repo>/data/skills and <repo>/data/chroma (any cwd)
# SIE_SKILLS_DIR=
# SIE_PERSIST_DIR=
